# tools-reforge/config.env - the ONLY place that names source files and work dirs (sourced by run.sh and the stages).
# All paths are WSL paths. PROJECT is derived from the location of this file, never hard-coded.

PROJECT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# --- the four raw sources -------------------------------------------------------------------------------------
# 1) LineageOS 24 guacamole. BASELINE = the raw images of the Oct 14 payload that r3 was built from.
SRC_LOS_BASELINE="$PROJECT/StockRom/LineageOS24/payload"
#    NEXT = the 20261109 nightly (stage 01 extracts it only when LOS=next).
SRC_LOS_NEXT_ZIP="$PROJECT/StockRom/LineageOS24/lineage-24.0-20261109-nightly-guacamole-signed.zip"
SRC_LOS_NEXT_SHA256="dc8d58908aa6ed7bd6a4f299473bc51c2c9cc6d75b2938bbea3a70ce091e19f7"
# 2) Axis GSI (ColorOS 17 PLK110 GSI): the system donor.
SRC_GSI_ZIP="$PROJECT/StockRom/AxisGSI/ColorOS-17-PLK110-1789230075256-18092026-AxisGSI.zip"
SRC_GSI_ZIP_SHA256="2842e697e30a04513050eefbf295e1f7911733ef9d7e964a028ec91e75efef64"
SRC_GSI_SYSTEM="$PROJECT/StockRom/AxisGSI/images/system.img"
SRC_GSI_SYSTEM_SHA256="2f5b15d0751c39d7a198c3a1f1bce711f8bf4bad8524ba516115ad6ae425469b"
# 3) Full-version donor: ColorOS 17 PLK110 full OTA (17.0.0.105). my_stock comes from its payload.
SRC_FULL_ZIP="$PROJECT/StockRom/PLK110-full/836f6828644542ed909a3d73af34f739_PLK110_11.C.76_1760_202610051308.zip"
SRC_FULL_ZIP_SHA256="d2a8b95ad93e2eeb3160ad11c6d76f23203c609cddbd45cb67d53fadd919b7ab"
SRC_FULL_IMAGES="$PROJECT/StockRom/PLK110-full/images"
# 4) Device stock OnePlus 7 Pro H.40 (camera stack, odm HAL services, reserve.img).
SRC_H40_ZIP="$PROJECT/StockRom/H40/b01e0f8dab434b79b884b1c31b11ccca_GM1910_11.H.40_4400_202303231745.zip"
SRC_H40_ZIP_SHA256="8969397b68ce534f7d3eeac244a3356774646cf4c9fdcffb7c3046ea0620afdb"
SRC_H40_IMAGES="$PROJECT/StockRom/H40/images"

# --- non-ROM inputs (kept in the repo) --------------------------------------------------------------------------
LIVE="$PROJECT/tools/live"            # pinned blobs and fix sources (moved into tools-reforge/ when tools/ is retired)
AVBTOOL="$PROJECT/tools/avb/avbtool.py"
AVB_KEY="${AVB_KEY:-$PROJECT/../Oneplus7ProPortKey/port_key.pem}"   # outside the repo, never copied into it (AutoPort makes its own)
MAGISK_APK="$PROJECT/release/17k/images/Magisk-v31.0.apk"                      # temporary: Magisk is not a ROM source

# --- work and output ------------------------------------------------------------------------------------------
WORK="${WORK:-/root/reforge-work}"                    # WSL ext4 (never /mnt/c): cache, trees, stamps
OUT="${OUT:-$PROJECT/release/trial/reforge-out}"      # finished images; promoted to release/<ver> only after approval
LOGDIR="$PROJECT/docs/logs"                           # log names: YYYY-MM-DD-reforge-<stage>.log
MIN_FREE_GB=70                                        # preflight refuses to start with less free space in $WORK

# LOS=baseline (default, reproduce r3) or LOS=next (20261109, phase P8)
LOS="${LOS:-baseline}"

# --- donor profile ------------------------------------------------------------------------------------------------
# DONOR=plk110 (default, OnePlus 15, ColorOS 17.0.0.105) or DONOR=pyb110 (OnePlus 16, 17.0.1.201).
# Identity strings are what the OTA's my_manifest actually says. Stages pin security_patch and first_api_level
# back to the OnePlus 7 Pro key blob (2022-12-05 / 28) after checking these donor values.
DONOR="${DONOR:-plk110}"
DONOR_COLOROS="17.0.0.105"
CACHE_TAG=full105
MY_STOCK_BYTES=4739280896
DONOR_MODEL=PLK110
DONOR_DEVICE=OP60FFL1
DONOR_DISPLAY_EXACT='PLK110_17.0.0.105(CN01)'
DONOR_DISPLAY_BRE='PLK110_17\.0\.0\.105(CN01)'
DONOR_VENDOR_PATCH=2026-09-01
DONOR_FIRST_API=36
MY_STOCK_DATA_IMG=my_stock-105.img
case "$DONOR" in
  plk110) ;;
  pyb110)
    SRC_FULL_ZIP="$PROJECT/StockRom/PYB110-full/6d23ff0b95a248ca94259c990615ac2c.zip"
    SRC_FULL_IMAGES="$PROJECT/StockRom/PYB110-full/images"
    DONOR_COLOROS="17.0.1.201"
    CACHE_TAG=pyb201
    MY_STOCK_BYTES=4760944640
    DONOR_MODEL=PYB110
    DONOR_DEVICE=OP64E1L1
    DONOR_DISPLAY_EXACT='PYB110_17.0.1.201(CN01)'
    DONOR_DISPLAY_BRE='PYB110_17\.0\.1\.201(CN01)'
    DONOR_VENDOR_PATCH=2026-11-01
    DONOR_FIRST_API=37
    MY_STOCK_DATA_IMG=my_stock-pyb201.img
    [ "$WORK" = /root/reforge-work ] && WORK=/root/reforge-work-pyb
    case "$OUT" in
      */reforge-out) OUT="$PROJECT/release/trial/reforge-out-pyb" ;;
    esac
    ;;
  *) echo "unknown DONOR=$DONOR" >&2; exit 1 ;;
esac
# AutoPort (autoport/autoport.sh) writes the donor values it detected in the user's ROM (version, sizes, identity strings, source
# paths) into a file and points AUTOPORT_ENV at it; unset for normal builds.
if [ -n "${AUTOPORT_ENV:-}" ]; then [ -f "$AUTOPORT_ENV" ] || { echo "AUTOPORT_ENV $AUTOPORT_ENV missing" >&2; exit 1; }; . "$AUTOPORT_ENV"; fi

# --- release naming (decided 2026-11-10): <donor ColorOS>-los<Lineage build date>-r<n> ---------------------------
case "$LOS" in
  baseline) LOS_DATE="20261011" ;;         # Oct 14 payload = lineage-24.0-20261011-nightly (docs/2026-10-14-porting-log.md)
  next)     LOS_DATE="20261109" ;;
esac
REV="${REV:-1}"                            # our own rebuild counter; +1 for each rebuild on the same two bases
RELEASE_NAME="${DONOR_COLOROS}-los${LOS_DATE}-r${REV}"
RELEASE_TAG="los${LOS_DATE}-r${REV}"       # shown in About phone: ro.build.display.id.show=GM1910_${DONOR_COLOROS}(${RELEASE_TAG})
